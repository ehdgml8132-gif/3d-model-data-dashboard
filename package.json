{
  "name": "3d-model-data-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:standalone": "npm run typecheck && node scripts/build-standalone.mjs",
    "build:site": "npm run build && node scripts/package-site.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "three": "^0.181.0",
    "web-ifc": "0.0.78"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
